{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fish",
  "version": "../package.json",
  "identifier": "fish.msg.fish",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fish",
        "url": "/app",
        "visible": false,
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "splash",
        "title": "Fish Updater",
        "url": "/splash",
        "width": 300,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNjcwNjg3RDZCQTg4MjIKUldRaWlMcldod1puNHNwbk1JT2RhRXdUWnhuc1UxZjhwbG5ML1FkcWFEVjVhMlhwTzF6eEtRaW8K",
      "endpoints": [
        "https://api.msg.fish/update/fish/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
