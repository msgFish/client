  "type": "module",
  "scripts": {
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cargo:sync": "bun sync-cargo.ts",
    "lex:rm-build": "rm -rf ./generated/lexicons",
    "lex:build": "bun run lex:rm-build && bunx lex build --out ./generated/lexicons",
    "tauri": "bun run cargo:sync && tauri",
    "dev": "bun run tauri dev",
    "build": "bun run tauri build",
    "build:dev": "bun run tauri build --debug"
  },
  "license": "MIT",
  "dependencies": {
    "@atproto/lex": "^0.0.24",
    "@tailwindcss/vite": "^4.2.2",
