{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fish",
  "version": "0.1.0",
  "identifier": "fish.msg.desktop",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fish",
        "url": "/app/chat",
        "visible": false,
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "splash",
        "url": "/splash",
        "width": 300,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["msgfish"]
      }
    }
  }
}
